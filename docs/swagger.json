{
    "openapi": "3.0.0",
    "info": {
        "title": "Tech Challenge API - Oficina Mecânica",
        "description": "API de gerenciamento da Oficina Mecânica desenvolvida para o Tech Challenge (SOAT - Fase 1).",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8080",
            "description": "Servidor Local (Docker)"
        }
    ],
    "paths": {
        "/usuarios": {
            "get": {
                "tags": [
                    "Usuários"
                ],
                "summary": "Lista todos os usuários ou filtra por tipo",
                "operationId": "b8ba246e72e2d430aaca5feb6c4c21aa",
                "parameters": [
                    {
                        "name": "tipo",
                        "in": "query",
                        "description": "Tipo de usuário para filtragem",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "cliente",
                                "mecanico",
                                "atendente"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de usuários retornada com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "properties": {
                                            "id": {
                                                "type": "integer",
                                                "example": 1
                                            },
                                            "nome": {
                                                "type": "string",
                                                "example": "João Silva"
                                            },
                                            "email": {
                                                "type": "string",
                                                "example": "joao@email.com"
                                            },
                                            "telefone": {
                                                "type": "string",
                                                "example": "11987654321",
                                                "nullable": true
                                            },
                                            "cpf": {
                                                "type": "string",
                                                "example": "123.456.789-00",
                                                "nullable": true
                                            },
                                            "tipo_usuario": {
                                                "type": "string",
                                                "example": "cliente",
                                                "enum": [
                                                    "cliente",
                                                    "mecanico",
                                                    "atendente"
                                                ]
                                            },
                                            "ativo": {
                                                "type": "boolean",
                                                "example": true
                                            },
                                            "criado_em": {
                                                "type": "string",
                                                "example": "2026-10-22 10:00:00"
                                            },
                                            "atualizado_em": {
                                                "type": "string",
                                                "example": "2026-10-22 10:00:00",
                                                "nullable": true
                                            }
                                        },
                                        "type": "object"
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Erro interno no servidor",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "erro": {
                                            "type": "string",
                                            "example": "Erro ao listar usuários."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Usuários"
                ],
                "summary": "Cadastra um novo usuário",
                "operationId": "f071d15bff0aecd6d52fcf84d83612b8",
                "requestBody": {
                    "description": "Dados para cadastro do usuário",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "nome",
                                    "email"
                                ],
                                "properties": {
                                    "nome": {
                                        "type": "string",
                                        "example": "João Silva"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "joao@email.com"
                                    },
                                    "telefone": {
                                        "type": "string",
                                        "example": "11987654321",
                                        "nullable": true
                                    },
                                    "cpf": {
                                        "type": "string",
                                        "example": "123.456.789-00",
                                        "nullable": true
                                    },
                                    "tipo_usuario": {
                                        "type": "string",
                                        "example": "cliente",
                                        "default": "cliente",
                                        "enum": [
                                            "cliente",
                                            "mecanico",
                                            "atendente"
                                        ]
                                    },
                                    "senha": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "senha123",
                                        "nullable": true
                                    },
                                    "ativo": {
                                        "type": "boolean",
                                        "example": true,
                                        "default": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Usuário cadastrado com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "id": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "nome": {
                                            "type": "string",
                                            "example": "João Silva"
                                        },
                                        "email": {
                                            "type": "string",
                                            "example": "joao@email.com"
                                        },
                                        "telefone": {
                                            "type": "string",
                                            "example": "11987654321",
                                            "nullable": true
                                        },
                                        "cpf": {
                                            "type": "string",
                                            "example": "123.456.789-00",
                                            "nullable": true
                                        },
                                        "tipo_usuario": {
                                            "type": "string",
                                            "example": "cliente"
                                        },
                                        "ativo": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "criado_em": {
                                            "type": "string",
                                            "example": "2026-10-22 10:00:00"
                                        },
                                        "atualizado_em": {
                                            "type": "string",
                                            "example": "2026-10-22 10:00:00",
                                            "nullable": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Dados inválidos / Erro de validação",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "erro": {
                                            "type": "string",
                                            "example": "O campo 'nome' é obrigatório."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Erro interno no servidor",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "erro": {
                                            "type": "string",
                                            "example": "Erro ao criar usuário."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
