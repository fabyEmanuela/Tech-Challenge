{
    "openapi": "3.0.0",
    "info": {
        "title": "Tech Challenge API - Oficina Mecânica",
        "description": "API de gerenciamento da Oficina Mecânica desenvolvida para o Tech Challenge (SOAT - Fase 1).",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8080",
            "description": "Servidor Local (Docker)"
        }
    ],
    "paths": {
        "/": {
            "get": {
                "tags": [
                    "Status"
                ],
                "summary": "Verifica a saúde da API e do Banco de Dados",
                "description": "Testa a conectividade com o MySQL e retorna as versões do PHP e do banco.",
                "operationId": "2e1b3f62d9319c22c096d8830f4feb36",
                "responses": {
                    "200": {
                        "description": "API e Banco de Dados operacionais",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "ok"
                                        },
                                        "php": {
                                            "type": "string",
                                            "example": "8.3.0"
                                        },
                                        "mysql": {
                                            "type": "string",
                                            "example": "8.4.0"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Banco de dados indisponível",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "erro"
                                        },
                                        "php": {
                                            "type": "string",
                                            "example": "8.3.0"
                                        },
                                        "mysql": {
                                            "type": "string",
                                            "example": "indisponível"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Status",
            "description": "Status"
        }
    ]
